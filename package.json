{
  "name": "kira-accounts-ops-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "seed": "tsx src/seed.ts",
    "demo": "tsx src/demo.ts",
    "dev": "tsx src/server.ts",
    "triage": "tsx src/triage.ts",
    "test": "tsx --test tests/api.test.ts tests/baseline.test.ts tests/regression.test.ts tests/triage.test.ts",
    "test:regression": "tsx --test tests/regression.test.ts",
    "test:triage": "tsx --test tests/triage.test.ts",
    "test:api": "tsx --test tests/api.test.ts",
    "test:baseline": "tsx --test tests/baseline.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.21"
  }
}
